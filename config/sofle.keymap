#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        shift: with_lshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "KEY_PRESS_WITH_LEFT_SHIFT_MODIFIER";
        };

        work: work {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp M &kp M &kp A &kp L &kp Y &kp N &kp H &kp O &kp P &kp E &kp M &kp U &kp N &kp N0 &kp N2 &kp N1 &kp N3 &kp N2 &kp N4 &kp ENTER>;
            label = "WORK";
        };

        pw: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER>;
            label = "PW";
        };
    };

    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            flavor = "tap-preferred";
            quick-tap-ms = <0>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        both {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&as_ht GRAVE GRAVE  &as_ht N1 N1  &as_ht N2 N2  &as_ht N3 N3      &as_ht N4 N4  &as_ht N5 N5       &as_ht N6 N6  &as_ht N7 N7    &as_ht N8 N8  &as_ht N9 N9  &as_ht N0 N0  &kp ENTER
&kp TAB             &as_ht Q Q    &as_ht W W    &as_ht E E        &as_ht R R    &as_ht T T         &as_ht Y Y    &as_ht U U      &as_ht I I    &as_ht O O    &as_ht P P    &kp BACKSLASH
&kp BACKSPACE       &as_ht A A    &as_ht S S    &as_ht D D        &as_ht F F    &as_ht G G         &as_ht H H    &as_ht J J      &as_ht K K    &as_ht L L    &as_ht SEMI SEMI  &as_ht SQT SQT
&kp LSHFT           &as_ht Z Z    &as_ht X X    &as_ht C C        &as_ht V V    &as_ht B B     &to 4      &kp C_MUTE  &as_ht N N    &as_ht M M      &as_ht COMMA COMMA  &as_ht DOT DOT  &as_ht FSLH FSLH  &kp ESC
                    &kp LCTRL     &kp LALT      &kp LEFT_COMMAND  &mo 4         &lt 1 SPACE        &lt 2 SPACE   &mt ENTER LEFT  &kp DOWN      &kp UP_ARROW  &kp RIGHT
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT RIGHT>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            label = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&as_ht GRAVE GRAVE  &kp EXCLAMATION  &kp AT_SIGN       &kp HASH              &kp DOLLAR  &kp PERCENT        &kp CARET  &kp AMPERSAND     &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans      &trans           &trans            &trans                &trans      &trans             &trans     &trans            &trans                 &trans                &trans                 &trans
&kp DELETE  &kp LEFT_BRACE   &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp EQUAL   &kp LESS_THAN      &kp CARET  &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RBKT              &kp RIGHT_BRACE        &kp SINGLE_QUOTE
&kp LSHFT   &kp ASTERISK     &kp SLASH         &kp PLUS              &kp MINUS   &kp PERCENT    &trans      &trans  &kp HASH   &kp AMPERSAND     &kp PIPE               &kp PERIOD            &kp DOLLAR             &kp BACKSLASH
            &trans           &trans            &trans                &trans      &trans             &trans     &trans            &trans                 &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&mt TILDE GRAVE  &kp EXCLAMATION  &kp AT_SIGN               &kp HASH              &kp DOLLAR  &kp PERCENT        &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ENTER
&trans           &trans           &trans                    &trans                &trans      &kp LG(LA(I))      &trans     &kp N7         &kp N8        &kp N9                &trans                 &trans
&trans           &trans           &kp LC(LS(LG(NUMBER_4)))  &kp LS(LG(NUMBER_4))  &trans      &trans             &trans     &kp NUMBER_4   &kp N5        &kp NUMBER_6          &trans                 &trans
&trans           &trans           &trans                    &trans                &trans      &trans         &trans      &trans  &trans     &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3          &trans                 &trans
                 &trans           &trans                    &trans                &trans      &trans             &trans     &trans         &kp ENTER     &kp N0                &kp DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        both_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "both";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4         &none  &none  &none  &none  &none  &none
&none       &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF      &none  &none  &none  &none  &none  &none
&none       &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                &none  &none  &none  &none  &none  &none
&none       &none            &none            &none            &none            &none            &rgb_ug RGB_TOG      &none  &none  &none  &none  &none  &none  &none
            &none            &none            &none            &none            &none                &none  &none  &none  &none  &none
            >;
        };

        special {
            label = "special";
            bindings = <
&trans        &kp F1         &kp F2            &kp F3         &kp F4             &kp F5             &kp F6  &kp F7     &kp F8        &kp F9     &kp F10  &work
&trans        &kp LA(LC(Z))  &kp LA(LC(LEFT))  &trans         &kp LA(LC(RIGHT))  &kp LA(LC(V))      &trans  &trans     &kp UP_ARROW  &trans     &trans   &trans
&trans        &kp LA(LC(D))  &kp LA(LC(E))     &kp LA(LC(F))  &kp LA(LC(T))      &kp LA(LC(G))      &trans  &kp LEFT   &kp DOWN      &kp RIGHT  &trans   &trans
&kp CAPSLOCK  &kp LA(LC(X))  &kp LA(LC(B))     &trans         &trans             &kp LA(LC(C))  &to 0      &kp LG(N0)  &trans  &trans     &trans        &trans     &trans   &pw
              &trans         &trans            &trans         &trans             &trans             &trans  &kp ENTER  &trans        &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LA(LEFT) LA(RIGHT)>,
                <&inc_dec_kp LG(PLUS) LG(KP_MINUS)>;
        };
    };
};
